# ═══════════════════════════════════════════════════════════
# NexPlay — PRODUCTION environment template
# Copy these into your host's Environment Variables panel
# (Render / Railway / Fly.io). Never commit real values.
# ═══════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=production
PORT=5000
# Your live frontend URL (Vercel domain or custom domain)
CLIENT_URL=https://thisismyweb.online
# Your live backend URL
API_URL=https://api.thisismyweb.online

# ── Database (Neon) ──
# Get a fresh connection string from console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Redis (optional — app runs without it) ──
# Leave empty to disable; cache falls back to in-memory.
REDIS_URL=""

# ── JWT ──
# Generate fresh 64-byte secrets for production. NEVER reuse dev secrets.
JWT_ACCESS_SECRET="GENERATE_A_NEW_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME="30d"

# ── Cookies ──
# COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_DOMAIN=thisismyweb.online
COOKIE_SECURE=true

# ── Email (SMTP) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="NexPlay <no-reply@thisismyweb.online>"

# ── Cloudinary (image uploads) ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── OAuth (optional) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://api.thisismyweb.online/api/v1/auth/google/callback"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_CALLBACK_URL="https://api.thisismyweb.online/api/v1/auth/discord/callback"

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Account Lockout ──
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# ── Seed admin (first deploy only) ──
SEED_ADMIN_EMAIL=admin@thisismyweb.online
SEED_ADMIN_PASSWORD="SET_A_STRONG_PASSWORD"
